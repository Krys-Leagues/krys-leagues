{
  "name": "krys-leagues",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:match-preview": "node --experimental-strip-types --test lib/importer/adapters/matchAdapter.test.ts",
    "test:stroke-history-preview": "node --experimental-strip-types --test lib/importer/adapters/historicalStrokeParser.test.ts",
    "test:competition-preview": "node --experimental-strip-types --test lib/importer/adapters/competitionPreview.test.ts lib/importer/adapters/kwtLibraryPreview.test.ts lib/importer/adapters/kwtDiscordEvidence.test.ts lib/importer/adapters/kwtDiscordStaging.test.ts lib/importer/adapters/kwtDiscordWeekReview.test.ts lib/importer/adapters/kwtDiscordReconciliation.test.ts",
    "test:climbers": "node --experimental-strip-types --test tests/all-time/climbers-ytd-display.test.ts",
    "test:discord-departure": "node --experimental-strip-types --test lib/discordDeparture.test.ts",
    "test:kwt-import": "node --experimental-strip-types --test lib/importer/adapters/kwtAdapter.test.ts",
    "test:monthly-import": "node --experimental-strip-types --test lib/importer/adapters/monthlyWebsiteAdapter.test.ts",
    "test:trophy-import": "node --experimental-strip-types --test lib/trophies/trophyImport.test.ts lib/trophies/trophyMedia.test.ts lib/trophies/pendingTrophyAssignments.test.ts",
    "test:all-time": "node --experimental-strip-types --test tests/all-time/*.test.ts",
    "audit:admin-access": "node scripts/audit-admin-data-boundary.mjs --changed",
    "audit:database-permissions": "node scripts/audit-database-permissions.mjs",
    "inventory:admin-access": "node scripts/generate-admin-access-inventory.mjs",
    "test:admin-access": "node --test tests/admin-access/*.test.mjs",
    "test:public-routes": "node --test tests/admin-access/public-routes.test.mjs",
    "test:workflow-contracts": "node --test tests/admin-access/workflow-contracts.test.mjs",
    "test:hardening": "npm run audit:admin-access && npm run audit:database-permissions && npm run test:admin-access && npm run test:public-routes && npm run test:workflow-contracts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.104.1",
    "next": "16.2.4",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
